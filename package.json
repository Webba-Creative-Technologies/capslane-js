{
  "name": "@webba_tech/capslane",
  "version": "0.1.4",
  "description": "JavaScript and TypeScript client for retrieving YouTube transcripts through the Capslane API.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./workflows": {
      "types": "./dist/workflows.d.ts",
      "import": "./dist/workflows.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepare": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Webba-Creative-Technologies/capslane-js.git"
  },
  "author": "Webba Creative Technologies",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "youtube",
    "transcript",
    "captions",
    "video-to-text",
    "api",
    "typescript"
  ],
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
